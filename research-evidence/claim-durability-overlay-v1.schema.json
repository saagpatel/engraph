{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/engraph-claim-durability-overlay-v1.schema.json",
  "title": "Engraph Claim Durability Overlay V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "claim_boundary",
    "schema_binding",
    "source_ledger",
    "source_claim_record",
    "source_archive",
    "historical_claims_source",
    "historical_claim_dispositions",
    "claim_surfaces",
    "claims",
    "future_search_protocol"
  ],
  "properties": {
    "schema": {"const": "engraph-claim-durability-overlay.v1"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "schema_binding": {"$ref": "#/$defs/boundFile"},
    "source_ledger": {"$ref": "#/$defs/boundFile"},
    "source_claim_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "path", "sha256", "availability"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "availability": {"const": "ARCHIVED_EXACT_BYTES"}
      }
    },
    "source_archive": {"$ref": "#/$defs/sourceArchive"},
    "historical_claims_source": {"$ref": "#/$defs/boundFile"},
    "historical_claim_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/historicalDisposition"}
    },
    "claim_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claimSurface"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "source_status",
          "durability_state",
          "public_use",
          "reason"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "source_status": {"type": "string", "minLength": 1},
          "durability_state": {"type": "string", "minLength": 1},
          "public_use": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "search_record": {"$ref": "#/$defs/searchRecord"}
        }
      }
    },
    "future_search_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "state", "required_capture", "decision_rule"],
      "properties": {
        "protocol_id": {"const": "engraph-novelty-search-protocol.v1"},
        "state": {"const": "REQUIRED_BEFORE_REASSERTION"},
        "required_capture": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_rule": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source_commit", "members"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/boundFile"}
        }
      }
    },
    "historicalDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source_status", "durability_state", "public_use"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "source_status": {"type": "string", "minLength": 1},
        "durability_state": {"type": "string", "minLength": 1},
        "public_use": {"type": "string", "minLength": 1}
      }
    },
    "claimSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "source_kind",
        "sha256",
        "disposition"
      ],
      "properties": {
        "surface_id": {"type": "string", "minLength": 1},
        "source_kind": {
          "enum": ["LIVE_FILE_SECTION", "ARCHIVE_EXCERPT"]
        },
        "path": {"type": "string", "minLength": 1},
        "start_marker": {"type": "string", "minLength": 1},
        "end_marker": {"type": "string", "minLength": 1},
        "archive_member": {"type": "string", "minLength": 1},
        "exact_excerpt": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "unknownField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "UNKNOWN"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "searchRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_state",
        "searched_at",
        "exact_queries",
        "search_surfaces",
        "inclusion_criteria",
        "exclusion_criteria",
        "stop_rule",
        "preserved_candidate_assertions",
        "preserved_negative_assertions",
        "claim_disposition",
        "universal_claim_allowed",
        "allowed_wording"
      ],
      "properties": {
        "execution_state": {"const": "HISTORICAL_SEARCH_UNPRESERVED"},
        "searched_at": {"$ref": "#/$defs/unknownField"},
        "exact_queries": {"$ref": "#/$defs/unknownField"},
        "search_surfaces": {"$ref": "#/$defs/unknownField"},
        "inclusion_criteria": {"$ref": "#/$defs/unknownField"},
        "exclusion_criteria": {"$ref": "#/$defs/unknownField"},
        "stop_rule": {"$ref": "#/$defs/unknownField"},
        "preserved_candidate_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate", "evidence_state"],
            "properties": {
              "candidate": {"type": "string", "minLength": 1},
              "canonical_identifier": {"type": "string", "minLength": 1},
              "evidence_state": {"const": "NAMED_IN_SOURCE_NOTE_ONLY"}
            }
          }
        },
        "preserved_negative_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion", "evidence_state"],
            "properties": {
              "assertion": {"type": "string", "minLength": 1},
              "evidence_state": {
                "const": "UNREPRODUCIBLE_SOURCE_NOTE_ASSERTION"
              }
            }
          }
        },
        "claim_disposition": {"const": "NOT_ESTABLISHED"},
        "universal_claim_allowed": {"const": false},
        "allowed_wording": {"type": "string", "minLength": 1}
      }
    }
  }
}
